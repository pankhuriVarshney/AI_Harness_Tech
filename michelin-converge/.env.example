# Copy to .env and fill in. NEVER commit the real .env.
GEMINI_API_KEY=

# Model routing (check https://ai.google.dev/gemini-api/docs/models for current names)
GEMINI_MODEL_FAST=gemini-2.0-flash
GEMINI_MODEL_FAST_FALLBACK=gemini-2.0-flash
GEMINI_MODEL_REASONING=gemini-2.0-flash

# Harness tuning
HARNESS_CALL_BUDGET=12
CIRCUIT_FAILURE_THRESHOLD=4
CIRCUIT_COOLDOWN_SEC=30
MAX_PROMPT_CHARS=30000
RATE_LIMIT_PER_MINUTE=30

PORT=5000
FLASK_DEBUG=true