# Copy this file to ".env" and fill in your own values. Never commit ".env".

# Your Gemini API key (e.g. from a Google AI Studio / college subscription key).
GEMINI_API_KEY=your_gemini_api_key_here

# Any Gemini model your key has access to. Flash models are fastest/cheapest
# and are enough for this harness's structured JSON calls.
GEMINI_MODEL=gemini-2.0-flash

# Flask server settings
PORT=5000
FLASK_DEBUG=true
