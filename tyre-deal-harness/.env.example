# Copy this file to .env and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: override the model. Google renames/retires Gemini models
# periodically - check https://ai.google.dev/gemini-api/docs/models
# for the current name before the hackathon if this default 404s.
GEMINI_MODEL=gemini-2.5-flash
